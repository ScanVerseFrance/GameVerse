{
  "name": "nexus-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus Launcher — plugin-neutral game launcher (GameVerse / SVU)",
  "author": "SVU",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
