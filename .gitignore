node_modules
dist
dist-electron
release
.vite
.env
.env.local
*.log
.DS_Store
Thumbs.db
# Per-user game downloads (can be tens of GB) — never commit.
downloads/
# Local SQLite + user assets created at runtime by Electron's userData
# path. The data/ folder under the repo root is the BUILT-IN ankergames
# JSON source (committed), but per-user state lands elsewhere; ignore
# any stray .db / .db-journal that lands in the tree.
*.db
*.db-journal
*.sqlite
*.sqlite-journal
# Claude Code agent config / workspace settings — personal, not project.
.claude/
# Local scratch JSON copies (rename-with-suffix during testing).
*Copie*.json
# Installer build artefacts — payload-active is a junction maintained
# by scripts/build-installer.mjs; payload-* are timestamped scratch
# copies of the launcher (each ~240 MB). None of this ships in git.
installer/payload
installer/payload-active
installer/payload-*
installer/node_modules
installer/assets/icon.png
# Generated icon binaries (created by scripts/gen-installer-art.mjs).
build/icon.ico
build/installer-icon.ico

# Hydra source kept locally as a UX cross-reference while we work
# toward feature parity. GPL upstream — must NEVER end up in our
# repo even by accident. Same goes for Cygwin / MSYS stack dumps
# that occasionally appear after a Bash subprocess crashes.
Hydra Source Code/
*.stackdump
# Raw asset scraping staging dir — copied to public/ at integration
# time, the served version lives there. Keeping `assets/` out of git
# avoids duplicating ~3 MB of PNGs.
/assets/
# Phase 2 Nexus Input — .NET build artifacts (bin/obj) + le binaire
# self-contained 69 MB (regen via `dotnet publish` dans tools/).
tools/nexus-input/NexusInput/bin/
tools/nexus-input/NexusInput/obj/
tools/nexus-input/dist/
# ViGEmBus installer (6 MB, fetché depuis github.com/nefarius/ViGEmBus
# au moment du build via scripts/fetch-vigembus.mjs ou manuellement).
# Pas commité pour éviter de redistribuer un binaire third-party
# dans le repo source — on le bundle UNIQUEMENT dans l'installer final.
installer-extras/*.exe

# Phase 2 overlay dev scratch — local IPC test client + offline frame dump
__test_overlay.cjs
scripts/test-overlay-flow.cjs
scripts/test-overlay-flow.last.json
test-yt-iframe/

# nexus-overlay CMake build artifacts (régénérés par scripts/build-installer.mjs
# avant electron-builder ; chaque build-<arch>/ pèse ~200 MB et contient des
# embedded git repos pour imgui/minhook qui polluent le tree).
tools/nexus-overlay/build/
tools/nexus-overlay/build-x64/
tools/nexus-overlay/build-x86/
